# ── Required — app refuses to start without these ────────────────────────

# Groq LLM (Generator + CRS scoring fallback)
GROQ_API_KEY=your_groq_api_key_here

# Jina embeddings (CRS extractor — anchor + prompt + output similarity)
JINA_API_KEY=your_jina_api_key_here

# Turso libSQL (audit receipts, z_traj, sessions, rate limits, run counter)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Admin Basic-auth password (gates /admin + /api/debug + /api/leads GET)
ADMIN_PASSWORD=change_me

# Cron bearer secret — protects /api/cron/synthetic from anonymous abuse
CRON_SECRET=change_me

# Public site URL — used by metadata/sitemap/robots/OpenGraph
NEXT_PUBLIC_SITE_URL=https://www.lexaureon.com

# ── Optional ───────────────────────────────────────────────────

# Claude API (optional — currently unused by the pipeline)
Claude_api_key=

# Stripe checkout link (if set, /api/billing/checkout responds with this URL)
NEXT_PUBLIC_PRO_CHECKOUT_URL=

# Remote log drain — warn/error entries are POSTed here as JSON.
# Works with Axiom HTTP intake, Logflare, Datadog logs intake, or any custom collector.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
