# ── Required ───────────────────────────────────────────────────

# Groq LLM (Generator + CRS scoring fallback)
GROQ_API_KEY=your_groq_api_key_here

# Jina embeddings (CRS extractor — anchor + prompt + output similarity)
JINA_API_KEY=your_jina_api_key_here

# Turso libSQL (audit receipts, z_traj, sessions)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Admin Basic-auth password (gates /admin + /api/debug)
ADMIN_PASSWORD=change_me

# Upstream Lex API (auth, billing, me) — REQUIRED in production
LEX_API_BASE_URL=https://api.lexaureon.com

# Public site URL — used by metadata/sitemap/robots
NEXT_PUBLIC_SITE_URL=https://www.lexaureon.com

# ── Optional ───────────────────────────────────────────────────

# Vercel KV — enables persistent rate limiting (falls back to in-memory if unset)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe checkout link (if set, bypasses backend /billing/checkout proxy)
NEXT_PUBLIC_PRO_CHECKOUT_URL=
