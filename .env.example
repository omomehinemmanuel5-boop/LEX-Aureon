# Lex Aureon — environment variables
# Copy to .env.local for local dev. Values here are placeholders only —
# get real values from Vercel → lexaureonfrontendx → Settings → Environment Variables.
# Source of truth for what's required vs optional: lib/env.ts

# ── Required (build/runtime will throw without these) ───────────────────────
GROQ_API_KEY=placeholder
JINA_API_KEY=placeholder
TURSO_DATABASE_URL=libsql://placeholder.turso.io
TURSO_AUTH_TOKEN=placeholder
ADMIN_PASSWORD=placeholder
CRON_SECRET=placeholder
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
VERCEL_TOKEN=
# Note: aliased — lib/env.ts reads this under the key "Claude_api_key" (lowercase c)
Claude_api_key=
NEXT_PUBLIC_PRO_CHECKOUT_URL=
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
BENCH_SECRET=
# Separate secret for operator-only MCP tools; ADMIN_PASSWORD is not accepted.
# If unset, only public MCP tools are available.
MCP_OPERATOR_SECRET=
# Exact comma-separated public HTTPS hostnames that /api/tool-proxy may call.
# Empty means outbound MCP forwarding is disabled.
TOOL_PROXY_ALLOWED_HOSTS=
