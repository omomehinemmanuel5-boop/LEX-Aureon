{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/python/*.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/python/:path*", "destination": "/api/python/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "lexaureon.com" }],
      "destination": "https://www.lexaureon.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/synthetic",
      "schedule": "0 12 * * *"
    }
  ]
}
